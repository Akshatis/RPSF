[Unit]
Description=RPSF TTMS POC
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rpsf-ttms
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/rpsf-ttms/server.js
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
